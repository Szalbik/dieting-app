<div class="mx-auto max-w-3xl space-y-6 px-4 py-10 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-xs text-brand-ink-soft"><%= link_to @diet.name, diet_path(@diet), class: "hover:underline" %></p>
      <h1 class="font-serif text-2xl font-bold text-brand-ink"><%= @diet_set.name %></h1>
    </div>
    <%= button_to 'Usuń dzień', diet_set_path(@diet_set), method: :delete, data: { confirm: 'Usunąć ten dzień i wszystkie jego posiłki?' }, class: 'text-sm font-medium text-rose-600 hover:text-rose-700' %>
  </div>

  <% totals = @diet_set.nutrition_totals %>
  <%= render Ui::CardComponent.new(tint: :peach, padding: :md) do %>
    <div class="flex items-baseline justify-between">
      <span class="font-serif text-lg font-bold text-brand-ink"><%= totals[:kcal].round %> kcal</span>
      <% if @diet.kcal_target.present? %>
        <span class="text-xs text-brand-ink-soft">cel: <%= @diet.kcal_target %> kcal</span>
      <% end %>
    </div>
    <div class="mt-1 text-sm text-brand-ink"><%= totals[:protein].round %>b · <%= totals[:fat].round %>t · <%= totals[:carbs].round %>w</div>
  <% end %>

  <div class="space-y-2">
    <% @diet_set.meals.each do |meal| %>
      <%= render Ui::CardComponent.new(padding: :sm) do %>
        <div class="flex items-center justify-between gap-3">
          <div class="min-w-0">
            <span class="text-xs font-semibold text-brand-navy"><%= Meal::SLOTS[meal.meal_type] || meal.meal_type %></span>
            <h3 class="truncate font-semibold text-brand-ink"><%= meal.name %></h3>
            <p class="text-xs text-brand-ink-soft"><%= meal.kcal.present? ? "#{meal.kcal} kcal" : 'brak makro' %></p>
          </div>
          <%= button_to 'Usuń', meal_path(meal), method: :delete, class: 'shrink-0 text-sm text-rose-600 hover:text-rose-700' %>
        </div>
      <% end %>
    <% end %>
    <% if @diet_set.meals.empty? %>
      <p class="text-sm text-brand-ink-soft">Brak posiłków w tym dniu.</p>
    <% end %>
  </div>

  <div class="dietcard p-4" data-controller="tabs">
    <h2 class="mb-3 font-serif text-lg font-bold text-brand-ink">Dodaj posiłek</h2>
    <div class="mb-4 flex rounded-full bg-brand-paper p-1">
      <% [["manual", "Napisz przepis"], ["library", "Z biblioteki"], ["other", "Z innej diety"]].each_with_index do |(val, label), i| %>
        <button type="button" data-tabs-target="pill" data-tab-value="<%= val %>" data-action="tabs#select" aria-selected="<%= i.zero? %>"
                class="flex-1 rounded-full py-2 text-xs font-semibold text-brand-ink-soft aria-selected:bg-brand-navy aria-selected:text-white">
          <%= label %>
        </button>
      <% end %>
    </div>

    <div data-tabs-target="panel" data-tab-value="manual">
      <%= form_with url: meals_path, method: :post, local: true, html: { class: "space-y-4" } do |f| %>
        <%= hidden_field_tag "meal[diet_set_id]", @diet_set.id %>
        <div>
          <%= label_tag "meal[meal_type]", "Slot posiłku", class: "block text-sm font-medium text-gray-900" %>
          <%= select_tag "meal[meal_type]", options_for_select(Meal::SLOTS.invert), class: "mt-1 block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
        </div>
        <div>
          <%= label_tag "meal[name]", "Nazwa", class: "block text-sm font-medium text-gray-900" %>
          <%= text_field_tag "meal[name]", nil, class: "mt-1 block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
        </div>
        <div>
          <%= label_tag "meal[ingredients_text]", 'Składniki (jedna linia = jeden składnik, np. "Kurczak - 200 g")', class: "block text-sm font-medium text-gray-900" %>
          <%= text_area_tag "meal[ingredients_text]", nil, rows: 4, class: "mt-1 block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
        </div>
        <div>
          <%= label_tag "meal[instructions]", "Sposób przygotowania", class: "block text-sm font-medium text-gray-900" %>
          <%= text_area_tag "meal[instructions]", nil, rows: 3, class: "mt-1 block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
        </div>
        <div class="grid grid-cols-4 gap-2">
          <%= number_field_tag "meal[kcal]", nil, placeholder: "kcal", class: "block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
          <%= number_field_tag "meal[protein]", nil, step: 0.1, placeholder: "białko", class: "block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
          <%= number_field_tag "meal[fat]", nil, step: 0.1, placeholder: "tłuszcz", class: "block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
          <%= number_field_tag "meal[carbs]", nil, step: 0.1, placeholder: "węgle", class: "block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
        </div>
        <%= submit_tag "Dodaj posiłek", class: "rounded-full bg-brand-navy px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </div>

    <div data-tabs-target="panel" data-tab-value="library" hidden>
      <% if @recipes.empty? %>
        <p class="text-sm text-brand-ink-soft">Nie masz jeszcze żadnych przepisów. <%= link_to "Dodaj przepis", new_recipe_path, class: "text-brand-navy hover:underline" %>.</p>
      <% else %>
        <%= form_with url: meals_path, method: :post, local: true, html: { class: "space-y-4" } do %>
          <%= hidden_field_tag "meal[diet_set_id]", @diet_set.id %>
          <%= select_tag "meal[recipe_id]", options_from_collection_for_select(@recipes, :id, :name), class: "block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
          <%= submit_tag "Dodaj z biblioteki", class: "rounded-full bg-brand-navy px-4 py-2 text-sm font-semibold text-white" %>
        <% end %>
      <% end %>
    </div>

    <div data-tabs-target="panel" data-tab-value="other" hidden>
      <% if @other_meals.empty? %>
        <p class="text-sm text-brand-ink-soft">Brak posiłków w innych dietach.</p>
      <% else %>
        <%= form_with url: meals_path, method: :post, local: true, html: { class: "space-y-4" } do %>
          <%= hidden_field_tag "meal[diet_set_id]", @diet_set.id %>
          <% grouped = @other_meals.group_by { |m| "#{m.diet_set.diet.name} — #{m.diet_set.name}" } %>
          <%= select_tag "meal[source_meal_id]", grouped_options_for_select(grouped.transform_values { |meals| meals.map { |m| ["#{m.name} (#{m.kcal} kcal)", m.id] } }), class: "block w-full rounded-md border-0 py-1.5 px-2 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm" %>
          <%= submit_tag "Skopiuj do tego dnia", class: "rounded-full bg-brand-navy px-4 py-2 text-sm font-semibold text-white" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
