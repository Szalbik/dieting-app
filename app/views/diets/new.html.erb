<div class="flex items-start w-full px-4 py-10 mx-auto max-w-3xl gap-x-8 sm:px-6 lg:px-8">
  <main class="flex-1" data-controller="tabs">
    <h2 class="text-base font-semibold leading-7 text-gray-900">Nowa dieta</h2>

    <% unless Current.user.ai_quota_available? %>
      <div class="mt-4 rounded-2xl border border-brand-peach/40 bg-brand-peach/10 p-4 text-sm text-brand-ink">
        <% if Current.user.subscribed? %>
          <p class="font-medium">Wykorzystałeś <%= User::AI_QUOTA_LIMITS.fetch(:pro) %> operacje AI w tym miesiącu (plan Pro).</p>
          <p class="mt-1 text-brand-ink-soft">Limit odnowi się 1. dnia przyszłego miesiąca.</p>
        <% else %>
          <p class="font-medium">Wykorzystałeś darmową operację AI w tym miesiącu.</p>
          <p class="mt-1 text-brand-ink-soft">Wgrywanie PDF odnowi się w przyszłym miesiącu, albo przejdź na Pro już teraz.</p>
          <%= link_to 'Przejdź na Pro — 10 zł/mies.', upgrade_path, class: 'mt-3 inline-block rounded-full bg-brand-navy px-5 py-2 text-xs font-semibold text-white hover:bg-brand-peach' %>
        <% end %>
      </div>
    <% end %>

    <% modes = [["pdf", "pdf", "Wgraj PDF"], ["generated", "ai", "Kreator AI"], ["manual", "manual", "Zacznij od zera"]]
                 .select { |source, _, _| Diet::CREATION_MODES.include?(source) } %>
    <% if modes.size > 1 %>
      <div class="mt-4 mb-6 flex rounded-full bg-brand-paper p-1">
        <% modes.each_with_index do |(_, val, label), i| %>
          <button type="button" data-tabs-target="pill" data-tab-value="<%= val %>" data-action="tabs#select" aria-selected="<%= i.zero? %>"
                  class="flex-1 rounded-full py-2 text-xs font-semibold text-brand-ink-soft aria-selected:bg-brand-navy aria-selected:text-white">
            <%= label %>
          </button>
        <% end %>
      </div>
    <% end %>

    <%= form_with(model: @diet, local: true, html: { class: "mt-4 space-y-8" }, data: { turbo: false }) do |form| %>
      <% if @diet.errors.any? %>
        <div role="alert" class="rounded-2xl border border-brand-peach/40 bg-brand-peach/10 p-4 text-sm text-brand-ink">
          <ul class="list-disc space-y-1 pl-5">
            <% @diet.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, 'Nazwa', class: 'block text-sm font-medium leading-6 text-gray-900' %>
        <div class="mt-2">
          <%= form.text_field :name, class: 'block w-full rounded-md border-0 py-1.5 px-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' %>
        </div>
      </div>

      <div data-tabs-target="panel" data-tab-value="pdf">
        <div>
          <%= form.label :meals_per_day, 'Posiłki dziennie', class: 'block text-sm font-medium leading-6 text-gray-900' %>
          <div class="mt-2">
            <%= form.number_field :meals_per_day, value: form.object.meals_per_day || 5, min: 1, max: 10, class: 'block w-full rounded-md border-0 py-1.5 px-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' %>
          </div>
          <p class="mt-1 text-sm leading-6 text-gray-600">Podpowiedź dla parsera, np. 5 posiłków dziennie.</p>
        </div>

        <div class="mt-6">
          <%= form.label :pdf, "Plik PDF", class: "block text-sm font-medium leading-6 text-gray-900" %>
          <%= form.file_field :pdf, class: "mt-2 block w-full rounded-md border-0 py-1.5 px-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300
              file:mr-4 file:ml-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-gray-50 file:text-gray-700
          ", id: "file-upload" %>
        </div>
      </div>

      <% if Diet::CREATION_MODES.include?("generated") %>
      <div data-tabs-target="panel" data-tab-value="ai" hidden>
        <p class="mb-4 text-sm text-gray-600">AI wygeneruje spersonalizowaną dietę na podstawie celu kalorycznego i preferencji.</p>

        <div>
          <%= form.label :kcal_target, 'Cel kaloryczny (kcal/dzień)', class: 'block text-sm font-medium leading-6 text-gray-900' %>
          <div class="mt-2">
            <%= form.number_field :kcal_target, placeholder: '1800', min: 800, max: 6000, class: 'block w-full rounded-md border-0 py-1.5 px-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' %>
          </div>
        </div>

        <div class="mt-6">
          <%= form.label :days_count, 'Liczba dni', class: 'block text-sm font-medium leading-6 text-gray-900' %>
          <div class="mt-2">
            <%= form.number_field :days_count, value: 7, min: 1, max: 14, class: 'block w-full rounded-md border-0 py-1.5 px-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' %>
          </div>
        </div>

        <fieldset class="mt-6">
          <legend class="text-sm font-medium leading-6 text-gray-900">Posiłki dziennie</legend>
          <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3">
            <% Meal::SLOTS.each do |value, label| %>
              <label class="flex items-center gap-2 text-sm text-gray-900">
                <%= check_box_tag "diet[slots][]", value, %w[breakfast lunch dinner].include?(value) %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="mt-6">
          <legend class="text-sm font-medium leading-6 text-gray-900">Jaki jest Twój cel?</legend>
          <div class="mt-2 space-y-2">
            <% Diet::GOAL_MACROS.each do |value, goal| %>
              <label class="flex items-start gap-3 rounded-md border border-gray-200 p-3 text-sm text-gray-900 has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50">
                <%= radio_button_tag 'diet[goal]', value, value == 'zwykla', class: 'mt-1' %>
                <span>
                  <span class="block font-medium"><%= goal['label'] %></span>
                  <span class="block text-gray-500"><%= goal['hint'] %></span>
                </span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="mt-6">
          <%= label_tag 'diet[preferences]', 'Preferencje / wykluczenia', class: 'block text-sm font-medium leading-6 text-gray-900' %>
          <div class="mt-2">
            <%= text_area_tag 'diet[preferences]', nil, rows: 3, placeholder: 'np. wegetariańska, bez orzechów, kuchnia śródziemnomorska', class: 'block w-full rounded-md border-0 py-1.5 px-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm' %>
          </div>
        </div>
      </div>

      <% end %>

      <% if Diet::CREATION_MODES.include?("manual") %>
      <div data-tabs-target="panel" data-tab-value="manual" hidden>
        <p class="text-sm text-gray-600">Utworzy pustą dietę. Dni i posiłki (własne przepisy lub skopiowane z innych diet) dodasz na kolejnym ekranie.</p>
      </div>
      <% end %>

      <div class="flex items-center justify-end mt-6 gap-x-6">
        <%= form.submit 'Zapisz', class: 'inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600' %>
      </div>
    <% end %>
  </main>
</div>
