<%# PDF diets with no parsed days yet: say what is happening instead of an empty list. %>
<div class="mx-auto w-full max-w-7xl px-4 pt-10 sm:px-6 lg:px-8" id="diet_pdf_status_<%= diet.id %>">
  <div class="mb-6 rounded-2xl border border-brand-ink/10 bg-white p-4">
    <% case diet.status %>
    <% when 'generating' %>
      <h2 class="text-sm font-semibold text-brand-ink">Wczytujemy Twój PDF…</h2>
      <p class="mt-1 text-xs text-brand-ink-soft">To zwykle trwa do minuty. Strona odświeży się sama, gdy dni i posiłki będą gotowe.</p>
    <% when 'failed' %>
      <h2 class="text-sm font-semibold text-rose-700">Nie udało się wczytać PDF</h2>
      <p class="mt-1 text-xs text-brand-ink-soft">Nie pobraliśmy za to operacji AI — możesz spróbować ponownie.</p>
      <% if diet.generation_error.present? %>
        <p class="mt-1 text-xs text-brand-ink-soft"><%= diet.generation_error.truncate(200) %></p>
      <% end %>
    <% else %>
      <h2 class="text-sm font-semibold text-brand-ink">Nie znaleziono posiłków w PDF</h2>
      <p class="mt-1 text-xs text-brand-ink-soft">Spróbuj przeparsować plik ponownie.</p>
    <% end %>
    <% if diet.status != 'generating' && diet.pdf.attached? %>
      <%= button_to 'Przeparsuj', reparse_diet_path(diet), method: :post, form_class: 'mt-3', class: 'rounded-full bg-brand-navy px-3 py-1.5 text-xs font-semibold text-white' %>
    <% end %>
  </div>
</div>
