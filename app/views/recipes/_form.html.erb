<%
  field_classes = 'mt-2 block w-full rounded-md border-0 py-1.5 px-2.5 text-brand-ink shadow-sm ring-1 ring-inset ring-brand-ink/15 focus:ring-2 focus:ring-inset focus:ring-brand-navy sm:text-sm sm:leading-6'
%>
<%= form_with(model: recipe, local: true, html: { data: { controller: 'ingredient-rows', action: 'submit->ingredient-rows#serialize', ingredient_rows_seed_value: recipe.ingredients.to_json } }) do |form| %>
  <% if recipe.errors.any? %>
    <div class="mb-4 rounded-md bg-rose-50 p-4 text-sm text-rose-700 ring-1 ring-inset ring-rose-200">
      <%= recipe.errors.full_messages.join(', ') %>
    </div>
  <% end %>

  <div class="space-y-6">
    <div>
      <%= form.label :name, 'Nazwa', class: 'block text-sm font-medium leading-6 text-brand-ink' %>
      <%= form.text_field :name, class: field_classes %>
    </div>

    <div>
      <%= form.label :meal_type, 'Slot posiłku', class: 'block text-sm font-medium leading-6 text-brand-ink' %>
      <%= form.select :meal_type, Meal::SLOTS.invert, { include_blank: 'Dowolny' }, class: field_classes %>
    </div>

    <div>
      <p class="block text-sm font-medium leading-6 text-brand-ink">Składniki</p>
      <div class="mt-2">
        <%= render 'shared/ingredient_rows', hidden_field: form.text_area(:ingredients_text, class: 'hidden', data: { ingredient_rows_target: 'hidden' }) %>
      </div>
    </div>

    <div>
      <%= form.label :instructions, 'Sposób przygotowania', class: 'block text-sm font-medium leading-6 text-brand-ink' %>
      <%= form.text_area :instructions, rows: 4, class: field_classes %>
    </div>

    <div>
      <p class="block text-sm font-medium leading-6 text-brand-ink">Wartości odżywcze <span class="font-normal text-brand-ink-soft">(opcjonalnie — jeśli puste, AI oszacuje ze składników)</span></p>
      <div class="mt-2 grid grid-cols-4 gap-2">
        <%= form.number_field :kcal, placeholder: 'kcal', class: field_classes.sub('mt-2 ', '') %>
        <%= form.number_field :protein, step: 0.1, placeholder: 'białko g', class: field_classes.sub('mt-2 ', '') %>
        <%= form.number_field :fat, step: 0.1, placeholder: 'tłuszcz g', class: field_classes.sub('mt-2 ', '') %>
        <%= form.number_field :carbs, step: 0.1, placeholder: 'węgle g', class: field_classes.sub('mt-2 ', '') %>
      </div>
    </div>
  </div>

  <div class="mt-8 flex items-center justify-end gap-x-4">
    <%= link_to 'Anuluj', recipes_path, class: 'text-sm font-semibold text-brand-ink-soft hover:text-brand-ink' %>
    <%= form.submit 'Zapisz', class: 'inline-flex justify-center rounded-full bg-brand-navy px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-navy-strong' %>
  </div>
<% end %>
