      <% [["01","📄","Wgraj PDF diety","Dodaj plik PDF od dietetyka. DietApp odczyta go automatycznie — niezależnie od formatu i układu."],["02","🍽️","Przeglądaj posiłki","Zobacz wszystkie posiłki poukładane wg dni i typów. Zamień na alternatywy sugerowane w planie jednym kliknięciem."],["03","📅","Zaplanuj tydzień","Wybierz posiłki na każdy dzień tygodnia. Mieszaj, powtarzaj albo trzymaj się dokładnie zaleceń dietetyka."],["04","🛒","Odbierz listę zakupów","Dokładna lista — ilości, kategorie, wszystko — gotowa do zabrania do sklepu lub udostępnienia w aplikacji dostawczej."]].each do |s| %>
