        <div class="mb-4 flex items-center justify-between"><div class="text-base font-bold font-serif">Posiłki — wtorek</div><span class="rounded-full bg-brand-sage/10 px-2.5 py-1 text-[0.7rem] font-medium text-brand-sage-dark">1840 kcal</span></div>
        <div class="space-y-3">
          <div class="flex items-center gap-3 rounded-2xl border border-brand-sage bg-brand-sage/10 p-4"><div class="text-3xl">🥣</div><div class="flex-1"><div class="text-sm font-medium">Owsianka z owocami</div><div class="text-xs text-brand-soft-gray">380 kcal · Śniadanie</div></div><div class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-brand-sage bg-brand-sage text-[0.65rem] text-white">✓</div></div>
          <div class="flex items-center gap-3 rounded-2xl border border-brand-sage bg-brand-sage/10 p-4"><div class="text-3xl">🥗</div><div class="flex-1"><div class="text-sm font-medium">Sałatka z grillowanym kurczakiem</div><div class="text-xs text-brand-soft-gray">520 kcal · Obiad</div></div><div class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-brand-sage bg-brand-sage text-[0.65rem] text-white">✓</div></div>
          <div class="flex items-center gap-3 rounded-2xl border border-transparent bg-brand-cream p-4"><div class="text-3xl">🍝</div><div class="flex-1"><div class="text-sm font-medium">Makaron z sosem pomidorowym</div><div class="text-xs text-brand-soft-gray">680 kcal · Kolacja</div></div><div class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-brand-sage-light text-[0.65rem] text-white">✓</div></div>
          <div class="flex items-center gap-3 rounded-2xl border border-transparent bg-brand-cream p-4"><div class="text-3xl">🍎</div><div class="flex-1"><div class="text-sm font-medium">Jabłko z masłem migdałowym</div><div class="text-xs text-brand-soft-gray">260 kcal · Przekąska</div></div><div class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-brand-sage-light text-[0.65rem] text-white">✓</div></div>
        </div>
