      <li><%= link_to "Dietetycy — beta", new_dietitian_waitlist_entry_path, class: "rounded-full bg-brand-sage-dark px-5 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-accent" %></li>
