        <details class="group rounded-2xl bg-brand-cream p-6">
          <summary class="cursor-pointer list-none text-base font-semibold text-brand-charcoal marker:content-none"><%= q %></summary>
          <p class="mt-3 text-sm leading-6 text-brand-soft-gray"><%= a %></p>
        </details>
      <% end %>
