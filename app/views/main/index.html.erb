    </div>

    <div class="relative hidden lg:block">
      <div class="absolute -left-16 bottom-20 rounded-2xl bg-white px-4 py-3 text-xs shadow-[0_12px_40px_rgba(0,0,0,0.1)]">
        <div class="text-[0.65rem] uppercase tracking-[0.05em] text-brand-soft-gray">Kalorie w tygodniu</div><div class="text-base font-bold">14 280</div><div class="text-[0.7rem] text-brand-sage-dark">↑ Zgodnie z planem</div>
      </div>
      <div class="absolute -right-10 top-16 rounded-2xl bg-white px-4 py-3 text-xs shadow-[0_12px_40px_rgba(0,0,0,0.1)]">
